        integer employee_id PK
        integer branch_id FK
        text first_name
        text last_name
        text job_title
        date hire_date
        text email
        boolean is_active
    }
    customers {
        integer customer_id PK
        text customer_name
        text customer_type
        text city
        text state
        text phone
        text email
        timestamptz created_at
        boolean is_active
    }
    suppliers {
        integer supplier_id PK
        text supplier_name
        text city
        text state
        text phone
        text email
        boolean is_active
    }
    categories {
        integer category_id PK
        text category_name UK
    }
    products {
        integer product_id PK
        integer category_id FK
        text sku UK
        text product_name
        numeric unit_price
        integer reorder_level
        boolean is_active
    }
    supplier_products {
        integer supplier_id PK,FK
        integer product_id PK,FK
        numeric supplier_unit_cost
        integer lead_time_days
