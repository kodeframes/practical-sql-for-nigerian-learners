        timestamptz payment_date
        numeric amount
        text payment_method
        text payment_status
        text reference_code
    }
    inventory_movements {
        integer movement_id PK
        integer branch_id FK
        integer product_id FK
        text movement_type
        integer quantity_change
        timestamptz movement_date
        text notes
    }
    deliveries {
        integer delivery_id PK
        integer order_id FK,UK
        date dispatch_date
        timestamptz delivered_at
        text delivery_status
        text delivery_city
        text delivery_state
        numeric delivery_fee
    }
    returns {
        integer return_id PK
        integer order_item_id FK
        date return_date
        integer quantity
        text reason
        text return_status
        numeric refund_amount
